{# Hidden Bootstrap/Tabler alert (Sylius 2.x native markup); revealed by furgonetka-admin-common.js on a failed connect. #}
{% trans_default_domain 'furgonetka' %}
<div id="furgonetka-connection-alert"
     class="mt-3 sylius alert alert-danger alert-dismissible"
     role="alert"
     style="display: none;"
     data-default-message="{{ 'sylius.furgonetka.connection_error'|trans }}">
    <div class="alert-icon">
        {{ ux_icon('tabler:exclamation-circle') }}
    </div>
    <div>
        <h4 class="alert-heading">{{ 'sylius.ui.error'|trans({}, 'messages') }}</h4>
        <div id="furgonetka-connection-alert-text" class="alert-description"></div>
    </div>
    <a class="btn-close" aria-label="close">
        {{ ux_icon('tabler:x') }}
    </a>
</div>
