{% trans_default_domain 'furgonetka' %}
{% set visible = options.visible is defined ? options.visible : true %}
{% set furgonetka_is_company_account = options.furgonetka_is_company_account %}

{% if visible %}
    <div class="btn-group">
        <button type="button" class="btn btn-primary"
                onclick="window.FurgonetkaAdmin.Modal.openModal('{{ url('furgonetka_sylius_furgonetka_plugin_admin_action_quick_package', {'orderId': data.id}) }}')">
            {{ 'sylius.furgonetka.quick_package'|trans }}
        </button>
        <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split"
                data-bs-toggle="dropdown" aria-expanded="false">
            <span class="visually-hidden">{{ 'sylius.furgonetka.furgonetka'|trans }}</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            {% if furgonetka_is_company_account %}
                <li>
                    <a class="dropdown-item" href="#"
                       onclick="window.FurgonetkaAdmin.Modal.openModal('{{ url('furgonetka_sylius_furgonetka_plugin_admin_action_quick_invoice', {'orderId': data.id}) }}'); return false;">
                        {{ 'sylius.furgonetka.create_invoice'|trans }}
                    </a>
                </li>
            {% endif %}
            <li>
                <a class="dropdown-item"
                   href="{{ url('furgonetka_sylius_furgonetka_plugin_admin_action_package_form', {'orderId': data.id}) }}">
                    {{ 'sylius.furgonetka.package'|trans }}
                </a>
            </li>
        </ul>
    </div>
{% endif %}
